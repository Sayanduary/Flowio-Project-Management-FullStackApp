{
  "version": 2,
  "buildCommand": "npm install && npm run postinstall",
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["generated/**", "prisma/**", "config/**", "inngest/**"]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ]
}
